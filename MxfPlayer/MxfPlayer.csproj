<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish\**</DefaultItemExcludes>
    <FFmpegBundleSource Condition="'$(FFmpegBundleSource)' == ''">C:\Tools\ffmpeg-8.1-full_build-shared\bin</FFmpegBundleSource>
    <MediaInfoBundleSource Condition="'$(MediaInfoBundleSource)' == ''">C:\Program Files\MediaInfo</MediaInfoBundleSource>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(FFmpegBundleSource)\*.dll;$(FFmpegBundleSource)\ffmpeg.exe;$(FFmpegBundleSource)\ffprobe.exe">
      <Link>FFmpeg\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(FFmpegBundleSource)\..\LICENSE">
      <Link>FFmpeg\LICENSE</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(MediaInfoBundleSource)\*.dll;$(MediaInfoBundleSource)\License.html">
      <Link>MediaInfo\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateBundledTools" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(FFmpegBundleSource)\avcodec-62.dll') Or !Exists('$(FFmpegBundleSource)\ffmpeg.exe')" Text="找不到 FFmpeg 8.x shared 工具，請設定 FFmpegBundleSource。" />
    <Error Condition="!Exists('$(MediaInfoBundleSource)\MediaInfo.dll')" Text="找不到 MediaInfo.dll，請設定 MediaInfoBundleSource。" />
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64'" Text="隨附工具為 x64，請使用 -r win-x64 發佈。" />
  </Target>

  <Target Name="WritePortableConfig" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)config.json" Lines="{ &quot;FFmpegPath&quot;: &quot;FFmpeg&quot;, &quot;MediaInfoPath&quot;: &quot;MediaInfo/MediaInfo.dll&quot; }" Overwrite="true" Encoding="UTF-8" />
  </Target>

 

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="8.0.0.1" />
    <PackageReference Include="LibVLCSharp" Version="3.9.6" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.9.6" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
  </ItemGroup>

</Project>
